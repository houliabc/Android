<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper_purple"
    android:orientation="vertical"
    android:padding="30dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="40dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_logo_foreground"
            android:background="@drawable/ic_logo_foreground"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QQ 注册"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="10dp"/>
    </LinearLayout>

    <!-- 昵称输入行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="昵称"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入昵称"
            android:textColorHint="#EEEEEE"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FFFFFF"/>
    </LinearLayout>

    <!-- 密码输入行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="密码"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/et_pwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入密码"
            android:textColorHint="#EEEEEE"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:backgroundTint="#FFFFFF"/>
    </LinearLayout>

    <!-- 确认密码输入行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="确认密码"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/et_pwd_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请再次输入密码"
            android:textColorHint="#EEEEEE"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:backgroundTint="#FFFFFF"/>
    </LinearLayout>

    <!-- 个性签名输入行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="个性签名"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/et_signature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入个性签名"
            android:textColorHint="#EEEEEE"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FFFFFF"/>
    </LinearLayout>

    <!-- 性别选择行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="性别"
            android:textSize="18sp"
            android:textColor="#FFFFFF"/>

        <Spinner
            android:id="@+id/sp_gender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFFFFF"
            android:entries="@array/gender_list"/>
    </LinearLayout>

    <!-- 注册按钮 -->
    <Button
        android:id="@+id/btn_register"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="点击注册"
        android:backgroundTint="#0099FF"
        android:textColor="#FFFFFF"/>

</LinearLayout>